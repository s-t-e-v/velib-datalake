# Development collection storage. The VM bootstrap configures "azure" in /etc/velib/app.env.
VELIB_STORAGE_BACKEND=local
VELIB_LOCAL_RAW_DIR=./raw

# The official export returns all records in one request. Parameters must be JSON.
VELIB_SOURCE_URL=https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/velib-disponibilite-en-temps-reel/exports/json
VELIB_SOURCE_PARAMS={}
VELIB_CONNECT_TIMEOUT_SECONDS=10
VELIB_READ_TIMEOUT_SECONDS=45
VELIB_HTTP_RETRIES=3
VELIB_HTTP_BACKOFF_SECONDS=1
VELIB_MIN_RECORDS=1000

# Initial assumption based on the roughly 30-minute publication lag observed live.
VELIB_FRESHNESS_MINUTES=45

# Development PostgreSQL. The VM bootstrap generates its own DATABASE_URL.
DATABASE_URL=postgresql://velib:velib@localhost:5432/velib

# Azure Blob access from a workstation uses DefaultAzureCredential, normally via Azure CLI login.
# The deployed VM uses its system-assigned managed identity and generated app configuration.
VELIB_STORAGE_ACCOUNT_URL=https://replace-me.blob.core.windows.net
VELIB_STORAGE_CONTAINER=velib-raw

